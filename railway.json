{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "node -e \"if (!require('fs').existsSync('dist/index.html')) require('child_process').execSync('npm run build', {stdio: 'inherit'})\""
  },
  "deploy": {
    "startCommand": "npm start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
