{
  "name": "cs2-mix-hub",
  "version": "1.0.0",
  "description": "Lobby de Mix CS2 com balanceamento por Level da Gamers Club e Pick/Ban de mapas em tempo real",
  "main": "server/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"node server/index.js --dev\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "client": "vite",
    "server": "node server/index.js"
  },
  "keywords": [
    "cs2",
    "gamersclub",
    "mix",
    "veto",
    "pick-and-ban",
    "matchmaking"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@vitejs/plugin-react": "^6.2.1",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "discord.js": "^14.28.1",
    "express": "^5.3.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^4.3.4",
    "vite": "^8.3.6"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
